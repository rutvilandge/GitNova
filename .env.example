# Copy to .env locally and replace each value with your own credentials.
# Keep .env ignored by Git. Never put secrets in frontend VITE_* variables.
DATABASE_URL=YOUR_NEON_POSTGRESQL_CONNECTION_STRING
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=YOUR_GROQ_MODEL_ID
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GITHUB_CLIENT_ID=YOUR_GITHUB_OAUTH_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_OAUTH_CLIENT_SECRET
GITHUB_WEBHOOK_SECRET=YOUR_GITHUB_WEBHOOK_SECRET
FRONTEND_URL=YOUR_FRONTEND_ORIGIN
BACKEND_URL=YOUR_BACKEND_ORIGIN
VITE_API_URL=YOUR_PUBLIC_BACKEND_ORIGIN
SESSION_COOKIE_SAME_SITE=YOUR_COOKIE_SAME_SITE_POLICY
SESSION_COOKIE_SECURE=YOUR_COOKIE_SECURE_SETTING
